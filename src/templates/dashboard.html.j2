      if (!critical.has(r.control_id) && CTL[r.control_id] && CTL[r.control_id].status === "Gap")
        year1.push(CTL[r.control_id]);
    });
    const y1 = new Set(year1.map(c => c.control_id));
    const year2 = gapCtl.filter(c => !y1.has(c.control_id));
    const year3 = D.controls.filter(c => c.status === "Partial");
    const col = (n, title, note, list, extra) => '<div class="year"><div class="yh"><b>Year ' + n + " " + title +
      "</b><span>" + note + "</span></div><ul>" +
      list.slice(0, 9).map(c => "<li><b>" + c.control_id + "</b> " + esc(c.control_name) + "</li>").join("") +
      (list.length > 9 ? '<li class="meta">and ' + (list.length - 9) + " more</li>" : "") + "</ul>" +
      '<div class="meta">' + extra + "</div></div>";
    $("#roadmap").innerHTML =
      col(1, "Foundation", year1.length + " controls", year1,
        "The Gap controls sitting on Critical risks, plus the rest of the top 5 recommendations.") +
      col(2, "Integration", year2.length + " controls", year2,
        "The remaining Gap controls, in the order their risks rank.") +
      col(3, "Optimization", year3.length + " controls", year3,
