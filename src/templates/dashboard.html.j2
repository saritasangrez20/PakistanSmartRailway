      ["Frozen Trust Score", a.trust_score_frozen_pct + "%", "warning", a.correct_frozen + " of " + a.total + ", reference frozen"],
      ["Recall of A2 mapping", a.recall_primary_pct + "%", "warning", "of the pairs we mapped by hand"],
      ["Automation Gain", a.automation_gain_pct + "%", "good", a.manual_minutes + " min to " + Math.round(a.ai_assisted_minutes) + " min"],
      ["Flagged for priority review", a.flagged_for_priority_review_pct + "%", "serious", "low confidence or weak framework"]
    ];
    $("#aiTiles").innerHTML = tiles.map(t =>
      '<div class="tile"><div class="k">' + t[0] + '</div><div class="v">' + t[1] + '</div>' +
      '<div class="foot"><span class="badge"><i class="bg-' + t[2] + '"></i>' +
      (t[2] === "good" ? "Holds" : "Watch") + '</span><span class="d">' + t[3] + "</span></div></div>").join("");

    if (D.ai_per_family && D.ai_per_family.length) {
      $("#aiFamily").innerHTML = '<table class="mini"><thead><tr><th>Framework</th><th>Suggestions</th>' +
        '<th style="width:38%">Trust</th><th style="width:38%">Recall of our mapping</th></tr></thead><tbody>' +
        D.ai_per_family.slice().sort((x, y) => x.recall_pct - y.recall_pct).map(f => {
          const cell = (v, extra) => '<td><div style="display:flex;align-items:center;gap:7px">' +
            '<div class="track" style="flex:1"><div class="fill" style="width:' + v + '%;background:var(--' +
            pctStatus(v) + ')"></div></div><span style="width:40px;text-align:right">' + v + "%</span></div>" +
            '<div class="meta">' + extra + "</div></td>";
          return "<tr><td><b>" + esc(f.family) + "</b></td><td>" + f.recommended + "</td>" +
            cell(f.trust_score_pct, f.correct + " of " + f.recommended + " acceptable") +
            cell(f.recall_pct, f.primary_found + " of " + f.primary + " found") + "</tr>";
        }).join("") + "</tbody></table>";
    }
    if (D.ai_backends && D.ai_backends.length) {
      const base = D.ai_backends.filter(b => b.backend !== "ollama")[0];
      if (base) {
        $("#aiBackends").innerHTML = '<table class="mini"><thead><tr><th></th><th>Local LLM</th><th>' +
          esc(base.backend) + "</th></tr></thead><tbody>" +
          [["Trust Score", a.trust_score_pct + "%", base.trust_score_pct + "%"],
           ["Frozen Trust Score", a.trust_score_frozen_pct + "%", base.trust_score_frozen_pct + "%"],
           ["Recall", a.recall_primary_pct + "%", base.recall_primary_pct + "%"],
           ["Runtime", Math.round(a.ai_runtime_minutes) + " min", base.runtime_seconds + " s"]]
            .map(r => "<tr><td>" + r[0] + "</td><td><b>" + r[1] + "</b></td><td>" + r[2] + "</td></tr>").join("") +
          "</tbody></table>" +
          '<div class="meta" style="margin-top:10px">Search alone scores better on precision and finds half as' +
          " much. The LLM earns its place on recall, which is the number that decides whether a gap is found.</div>";
      }
    }

    bars($("#aiAcc"), [
      { name: "Trust Score", value: a.trust_score_pct, display: a.trust_score_pct + "%", status: "good",
        tip: "Graded against the full " + a.reference_rows + " row reference: " + a.correct + " of " + a.total },
      { name: "Frozen reference", value: a.trust_score_frozen_pct, display: a.trust_score_frozen_pct + "%",
        status: "warning", tip: "Excludes the " + a.reference_added_during_review +
          " rows added during review, " + a.reference_added_that_ai_suggested + " of which the model had suggested" },
      { name: "Accepted by reviewers", value: a.human_trust_score_pct, display: a.human_trust_score_pct + "%",
        status: "good", tip: a.human_accepted + " accepted, " + a.human_rejected + " rejected" },
      { name: "Recall, primary set", value: a.recall_primary_pct, display: a.recall_primary_pct + "%",
        status: "warning", tip: "How much of our own A2 and A3 mapping the model found" }
    ], { max: 100, label: "160px" });

    bars($("#aiEffort"), [
      { name: "By hand", value: a.manual_minutes, display: Math.round(a.manual_minutes / 6) / 10 + " hrs",
        status: "critical", tip: "Measured on a sample and scaled to 25 controls" },
      { name: "Model runtime", value: a.ai_runtime_minutes, display: Math.round(a.ai_runtime_minutes) + " min",
        status: "warning", tip: "qwen2.5:7b on local hardware, one pass over 25 controls" },
      { name: "Human review", value: a.human_review_minutes, display: a.human_review_minutes + " min",
        status: "warning", tip: a.review_minutes_per_suggestion + " min per suggestion, " + a.suggestions + " suggestions" },
      { name: "AI assisted total", value: a.ai_assisted_minutes,
        display: Math.round(a.ai_assisted_minutes / 6) / 10 + " hrs", status: "good", tip: "Runtime plus review" }
    ], { max: a.manual_minutes, label: "150px" });
  })();
  window.PSR = { closeDrawer, drawer, scrim, open };
  document.dispatchEvent(new CustomEvent("psr:ready"));
})();
</script>
<script>{% include "motion.js.j2" %}</script>
</body>
</html>
