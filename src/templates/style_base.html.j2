<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
<style>
  /* Design language follows current product dashboards (shadcn/ui dashboard block, Linear, Grafana):
     Inter, 13-14px base, sentence case labels, hairline borders instead of shadows, ghost status
     badges with a coloured dot, and colour kept for the data rather than the chrome. */
  :root {
    color-scheme: light;
    --plane: #fafaf9; --surface: #ffffff; --inset: #f5f5f4; --raised: #fafaf9;
    --border: #e7e5e4; --hairline: #f0efed;
    --text-primary: #1c1917; --text-secondary: #57534e; --text-muted: #a8a29e;
    --series-1: #2a78d6; --track: #eeedeb; --target: #1c1917;
    --good: #0ca30c; --warning: #fab219; --serious: #ec835a; --critical: #d03b3b;
    --wash: #f5f5f4; --ring: rgba(28,25,23,.08);
    --r-card: 12px; --r-ctl: 8px;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
      --plane: #0a0a0a; --surface: #141413; --inset: #1c1c1b; --raised: #1c1c1b;
      --border: #292927; --hairline: #211f1e;
      --text-primary: #fafaf9; --text-secondary: #a8a29e; --text-muted: #78716c;
      --series-1: #3987e5; --track: #262625; --target: #fafaf9;
      --wash: #1c1c1b; --ring: rgba(255,255,255,.08);
    }
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --plane: #0a0a0a; --surface: #141413; --inset: #1c1c1b; --raised: #1c1c1b;
    --border: #292927; --hairline: #211f1e;
    --text-primary: #fafaf9; --text-secondary: #a8a29e; --text-muted: #78716c;
    --series-1: #3987e5; --track: #262625; --target: #fafaf9;
    --wash: #1c1c1b; --ring: rgba(255,255,255,.08);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--plane); color: var(--text-primary);
         font: 400 13.5px/1.55 Inter, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
         font-feature-settings: "cv05" 1, "ss01" 1; -webkit-font-smoothing: antialiased; }
  a { color: inherit; }
  button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
  input, select { font: inherit; color: inherit; }
  .num, .v, .val, table.tbl td, .kv td:last-child { font-variant-numeric: tabular-nums; }

  /* ---------- shell ---------- */
  .shell { display: grid; grid-template-columns: 252px 1fr; min-height: 100vh; }
  .sidebar { position: sticky; top: 0; height: 100vh; overflow-y: auto; background: var(--plane);
             border-right: 1px solid var(--border); display: flex; flex-direction: column; }
  .brand { padding: 20px 20px 16px; }
  .brand .mark { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 14.5px;
                 letter-spacing: -.011em; }
  .brand .mark span.badge { height: 28px; padding: 0 8px; border-radius: 8px; background: var(--text-primary);
        color: var(--surface); display: grid; place-items: center; font-size: 10.5px; font-weight: 600;
        letter-spacing: .04em; flex: none; border: 0; }
  .brand .org { color: var(--text-muted); font-size: 12px; margin-top: 10px; line-height: 1.5; }
  nav { padding: 4px 12px; flex: 1; }
  nav .group { color: var(--text-muted); font-size: 11.5px; padding: 14px 8px 5px; letter-spacing: .01em; }
  nav a { display: flex; align-items: center; gap: 10px; padding: 6px 8px; border-radius: var(--r-ctl);
          color: var(--text-secondary); text-decoration: none; font-size: 13px; }
  nav a svg { width: 15px; height: 15px; flex: none; opacity: .7; }
  nav a:hover { background: var(--inset); color: var(--text-primary); }
  nav a.on { background: var(--inset); color: var(--text-primary); font-weight: 500; }
  nav a.on svg { opacity: 1; }
  .sidebar footer { padding: 14px 20px 18px; color: var(--text-muted); font-size: 11.5px; line-height: 1.55;
                    border-top: 1px solid var(--hairline); }
  .sidebar footer code { font-size: 11px; }

  main { min-width: 0; background: var(--plane); }
  .topbar { position: sticky; top: 0; z-index: 30; display: flex; align-items: center; gap: 12px;
            padding: 0 28px; height: 56px; background: color-mix(in srgb, var(--plane) 82%, transparent);
            backdrop-filter: saturate(180%) blur(10px); border-bottom: 1px solid var(--border); }
  .topbar h1 { font-size: 14px; font-weight: 600; margin: 0; letter-spacing: -.011em; }
  .topbar .crumb { color: var(--text-muted); font-size: 13px; }
  .topbar .crumb::before { content: "/"; margin-right: 10px; color: var(--border); }
  .topbar .spacer { flex: 1; }
  .status-pill { display: inline-flex; align-items: center; gap: 7px; padding: 4px 11px; border-radius: 999px;
                 border: 1px solid var(--border); background: var(--surface); font-size: 12px; font-weight: 500;
                 color: var(--text-secondary); }
  .btn { display: inline-flex; align-items: center; gap: 7px; padding: 6px 11px; border-radius: var(--r-ctl);
         border: 1px solid var(--border); background: var(--surface); font-size: 13px; font-weight: 500;
         color: var(--text-secondary); }
  .btn:hover { background: var(--inset); color: var(--text-primary); }
  .btn svg { width: 14px; height: 14px; }

  .sec { padding: 34px 28px 12px; max-width: 1560px; scroll-margin-top: 56px; }
  .sec > header { margin-bottom: 18px; }
  .eyebrow { font-size: 12px; color: var(--text-muted); font-weight: 500; }
  .sec h2 { font-size: 21px; font-weight: 600; margin: 4px 0 6px; letter-spacing: -.021em; }
  .sec .lede { color: var(--text-secondary); max-width: 82ch; font-size: 13.5px; }

  .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-card);
          padding: 18px 20px 20px; }
  .card > h3 { font-size: 13.5px; font-weight: 600; letter-spacing: -.006em; color: var(--text-primary);
               margin: 0 0 14px; display: flex; align-items: baseline; gap: 10px; }
  .card > h3 .aside { margin-left: auto; font-size: 12px; color: var(--text-muted); font-weight: 400;
                      letter-spacing: 0; }
  .grid { display: grid; gap: 16px; }
  .grid > * { min-width: 0; }
  .g2 { grid-template-columns: 1fr 1fr; }
  .g3 { grid-template-columns: repeat(3, 1fr); }
  .g6 { grid-template-columns: repeat(6, 1fr); }
  /* 12 KPIs read better four to a row on screen; print puts them back on one band of six */
  .tiles { grid-template-columns: repeat(4, 1fr); }
  .g-2-1 { grid-template-columns: 2fr 1fr; }
  .g-1-2 { grid-template-columns: 1fr 2fr; }

  /* ---------- stat tiles ---------- */
  .tile { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-card);
          padding: 16px 18px 17px; }
  .tile .k { color: var(--text-secondary); font-size: 12.5px; line-height: 1.35; min-height: 34px; }
  .tile .v { font-size: 29px; font-weight: 600; line-height: 1.12; margin: 2px 0 10px;
             letter-spacing: -.028em; }
  .tile .v small { font-size: 14px; font-weight: 400; color: var(--text-muted); letter-spacing: 0; }
  .tile .foot { display: flex; align-items: center; gap: 8px; }
  .tile .d { color: var(--text-muted); font-size: 12px; line-height: 1.35; }

  .badge { display: inline-flex; align-items: center; gap: 5px; padding: 2px 8px; border-radius: 999px;
           border: 1px solid var(--border); background: var(--surface); font-size: 11.5px; font-weight: 500;
           color: var(--text-secondary); white-space: nowrap; }
  .badge i, .chip i, .pill i { width: 6px; height: 6px; border-radius: 50%; display: inline-block; flex: none; }
  .pill { display: inline-flex; align-items: center; gap: 6px; padding: 2px 9px; border-radius: 999px;
          border: 1px solid var(--border); background: var(--surface); font-size: 11.5px; font-weight: 500;
          color: var(--text-secondary); white-space: nowrap; }
  .chip { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text-secondary); }
  .s-good { color: var(--good); } .s-warning { color: var(--warning); }
  .s-serious { color: var(--serious); } .s-critical { color: var(--critical); }
  .bg-good { background: var(--good); } .bg-warning { background: var(--warning); }
  .bg-serious { background: var(--serious); } .bg-critical { background: var(--critical); }

  /* ---------- bars ---------- */
  .bar-row { display: grid; grid-template-columns: var(--label, 150px) 1fr 56px; align-items: center;
             gap: 12px; margin: 7px 0; }
  .bar-row .name { color: var(--text-secondary); font-size: 12.5px; white-space: nowrap; overflow: hidden;
                   text-overflow: ellipsis; }
  .bar-row .val { text-align: right; font-size: 12.5px; color: var(--text-primary); font-weight: 500; }
  .track { position: relative; height: 7px; background: var(--track); border-radius: 999px; }
  .fill { position: absolute; left: 0; top: 0; bottom: 0; background: var(--series-1); border-radius: 999px; }
  .tick { position: absolute; top: -3px; bottom: -3px; width: 2px; background: var(--target); border-radius: 2px;
          opacity: .55; }
  .seg { display: flex; height: 10px; border-radius: 999px; overflow: hidden; gap: 2px; background: transparent; }
  .seg > span { display: block; }
  .seg-legend { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 12px; color: var(--text-secondary);
                font-size: 12px; }

  /* ---------- heat map ---------- */
  .heat { display: grid; grid-template-columns: 78px repeat(5, 1fr); gap: 4px; }
  .heat .hcell { aspect-ratio: 1.12 / 1; border-radius: 10px; display: grid; place-items: center;
                 position: relative; cursor: pointer; border: 1px solid transparent; transition: border-color .12s; }
  .heat .hcell .n { font-size: 19px; font-weight: 600; letter-spacing: -.02em; }
  .heat .hcell .ids { font-size: 10px; color: var(--text-muted); margin-top: 2px; }
  .heat .hcell.empty { cursor: default; }
  .heat .hcell:not(.empty):hover { border-color: var(--text-muted); }
  .heat .hcell.sel { border-color: var(--text-primary); }
  .heat .ax { color: var(--text-muted); font-size: 12px; display: grid; place-items: center; }
  .heat .ax.row { justify-content: end; text-align: right; padding-right: 10px; }
  .axis-title { color: var(--text-muted); font-size: 12px; }
  .tabs { display: inline-flex; gap: 0; padding: 3px; background: var(--inset); border-radius: 9px; }
  .tabs button { padding: 4px 12px; border-radius: 6px; font-size: 12.5px; font-weight: 500;
                 color: var(--text-secondary); }
  .tabs button.on { background: var(--surface); color: var(--text-primary); box-shadow: 0 1px 2px var(--ring); }

  /* ---------- filters + tables ---------- */
  .filters { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 14px; }
  .search { display: flex; align-items: center; gap: 8px; padding: 6px 11px; border: 1px solid var(--border);
            border-radius: var(--r-ctl); background: var(--surface); min-width: 260px; }
  .search:focus-within { border-color: var(--text-muted); }
  .search input { border: 0; outline: 0; background: none; width: 100%; font-size: 13px; }
  .search input::placeholder { color: var(--text-muted); }
  .search svg { width: 14px; height: 14px; color: var(--text-muted); flex: none; }
  .fchip { padding: 5px 11px; border-radius: var(--r-ctl); border: 1px solid var(--border);
           background: var(--surface); font-size: 12.5px; font-weight: 500; color: var(--text-secondary); }
  .fchip:hover { background: var(--inset); color: var(--text-primary); }
  .fchip.on { background: var(--text-primary); color: var(--surface); border-color: var(--text-primary); }
  .count { color: var(--text-muted); font-size: 12.5px; margin-left: auto; }
  select.sel { padding: 6px 10px; border: 1px solid var(--border); border-radius: var(--r-ctl);
               background: var(--surface); font-size: 13px; color: var(--text-secondary); }

  .tbl-wrap { overflow: auto; max-height: 620px; border: 1px solid var(--border); border-radius: var(--r-card);
              background: var(--surface); }
  table.tbl { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 13px; }
  table.tbl th { position: sticky; top: 0; z-index: 2; background: var(--inset); text-align: left;
                 padding: 10px 14px; font-size: 12px; font-weight: 500; color: var(--text-secondary);
                 border-bottom: 1px solid var(--border); white-space: nowrap; cursor: pointer;
                 user-select: none; }
  table.tbl th:hover { color: var(--text-primary); }
  table.tbl th .arrow { color: var(--text-muted); font-size: 9px; }
  table.tbl td { padding: 11px 14px; border-bottom: 1px solid var(--hairline); vertical-align: top;
                 line-height: 1.45; }
  table.tbl tbody tr:last-child td { border-bottom: 0; }
  table.tbl tbody tr { cursor: pointer; }
  table.tbl tbody tr:hover td { background: var(--inset); }
  table.tbl td.id { font-weight: 500; white-space: nowrap; }
  table.tbl td.num { text-align: right; white-space: nowrap; }
  table.tbl td.wrap { color: var(--text-secondary); }
  .empty-note { padding: 30px; text-align: center; color: var(--text-muted); font-size: 13px; }
  .meta { color: var(--text-muted); font-size: 12px; line-height: 1.5; }
  ol.rank { margin: 0; padding-left: 20px; }
  ol.rank li { margin-bottom: 9px; padding-left: 2px; }
  ol.rank li::marker { color: var(--text-muted); font-size: 12px; }
  .kv { width: 100%; border-collapse: collapse; }
  .kv td { padding: 7px 0; border-bottom: 1px solid var(--hairline); font-size: 13px;
           color: var(--text-secondary); }
  .kv td:first-child { padding-right: 12px; }
  .kv td:last-child { text-align: right; font-weight: 500; color: var(--text-primary); }
  .kv tr:last-child td { border-bottom: 0; }
  .big { font-size: 26px; font-weight: 600; letter-spacing: -.025em; }

  /* ---------- drawer ---------- */
  .scrim { position: fixed; inset: 0; background: rgba(12,10,9,.4); opacity: 0; pointer-events: none;
           transition: opacity .18s ease; z-index: 50; }
  .scrim.open { opacity: 1; pointer-events: auto; }
  .drawer { position: fixed; top: 0; right: 0; width: min(600px, 95vw); height: 100vh; background: var(--surface);
            border-left: 1px solid var(--border); z-index: 51; transform: translateX(100%);
            transition: transform .22s cubic-bezier(.22,.61,.36,1); display: flex; flex-direction: column;
            box-shadow: -24px 0 48px -24px rgba(12,10,9,.25); }
  .drawer.open { transform: none; }
  .drawer .dhead { padding: 18px 22px 16px; border-bottom: 1px solid var(--hairline); display: flex;
                   align-items: flex-start; gap: 12px; }
  .drawer .dhead .t { font-size: 16px; font-weight: 600; line-height: 1.35; letter-spacing: -.014em;
                      margin-top: 3px; }
  .drawer .dbody { padding: 18px 22px 40px; overflow-y: auto; }
  .drawer .dbody h4 { font-size: 12px; font-weight: 500; color: var(--text-muted); margin: 22px 0 9px; }
  .drawer .dbody h4:first-child { margin-top: 0; }
  .drawer .dbody p { margin: 0 0 9px; color: var(--text-secondary); font-size: 13px; }
  .links { display: flex; flex-wrap: wrap; gap: 7px; }
  .link { padding: 4px 10px; border: 1px solid var(--border); border-radius: var(--r-ctl); font-size: 12.5px;
          background: var(--surface); color: var(--text-secondary); white-space: nowrap; }
  .link:hover { background: var(--inset); color: var(--text-primary); }
  .mini { width: 100%; border-collapse: collapse; font-size: 12.5px; }
  .mini th { text-align: left; color: var(--text-muted); font-weight: 400; padding: 0 10px 6px 0; }
  .mini td { padding: 8px 10px 8px 0; border-top: 1px solid var(--hairline); color: var(--text-secondary);
             vertical-align: top; }
  .mini td:first-child { color: var(--text-primary); white-space: nowrap; }

  #tip { position: fixed; z-index: 70; pointer-events: none; opacity: 0; transition: opacity .1s;
         background: var(--text-primary); color: var(--surface); padding: 7px 10px; border-radius: 7px;
         font-size: 12px; max-width: 300px; line-height: 1.45;
         box-shadow: 0 8px 24px -8px rgba(12,10,9,.4); }
  #tip.on { opacity: 1; }

  .roadmap { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .year { border: 1px solid var(--border); border-radius: var(--r-card); background: var(--surface);
          padding: 18px 20px; }
  .year .yh { display: flex; align-items: baseline; gap: 10px; margin-bottom: 12px; }
  .year .yh b { font-size: 13.5px; font-weight: 600; letter-spacing: -.006em; }
  .year .yh span { color: var(--text-muted); font-size: 12px; margin-left: auto; }
  .year ul { margin: 0 0 12px; padding-left: 0; list-style: none; }
  .year li { margin-bottom: 7px; color: var(--text-secondary); font-size: 13px; }
  .year li b { color: var(--text-primary); font-weight: 500; }

  footer.page-foot { padding: 26px 28px 44px; color: var(--text-muted); font-size: 12px; max-width: 1560px; }

  @media screen and (max-width: 1240px) {
    .g6, .tiles { grid-template-columns: repeat(3, 1fr); }
    .g3, .g-2-1, .g-1-2, .roadmap { grid-template-columns: 1fr; }
  }
  @media screen and (max-width: 880px) {
    .shell { grid-template-columns: 1fr; }
    .sidebar { position: static; height: auto; border-right: 0; border-bottom: 1px solid var(--border); }
    nav { display: flex; overflow-x: auto; padding: 8px; }
    nav a { white-space: nowrap; } nav .group { display: none; }
    .sidebar footer { display: none; }
    .g6, .g2, .tiles { grid-template-columns: repeat(2, 1fr); }
    .sec { padding: 22px 16px 6px; }
    .topbar { padding: 0 16px; }
    .heat { grid-template-columns: 46px repeat(5, 1fr); }
  }

  /* ---------- print: the brief asks for ONE page, so only the executive view prints ---------- */
  @page { size: A4 landscape; margin: 8mm; }
  @media print {
    body { background: #fff; font-size: 10px; }
    .shell { display: block; }
    .sidebar, .topbar, .drawer, .scrim, #tip, .sec:not(.page), footer.page-foot { display: none !important; }
    .page { padding: 0 2px 0 0 !important; max-width: none; }
    .tiles { grid-template-columns: repeat(6, 1fr) !important; }  /* keep the last card border inside the clip */
    .page > header { display: none; }
    .print-head { display: flex !important; padding-bottom: 5px; margin-bottom: 7px; }
    .print-head h1 { font-size: 13px; }
    .grid { gap: 6px !important; }
    .card { padding: 8px 10px; border-radius: 7px; }
    .card > h3 { margin-bottom: 5px; font-size: 10.5px; }
    .tile { padding: 6px 8px; border-radius: 7px; }
    .tile .k { font-size: 9.5px; } .tile .v { font-size: 17px; margin: 2px 0 1px; }
    .tile .k { min-height: 0; } .tile .d { font-size: 9px; } .tile .foot { gap: 5px; }
    .badge { font-size: 9px; padding: 0 5px; }
    .bar-row { margin: 1px 0; grid-template-columns: 152px 1fr 48px !important; gap: 8px; }
    .track { height: 6px; } .bar-row .name, .bar-row .val { font-size: 9.5px; }
    .kv td { padding: 2px 0; font-size: 10px; }
    ol.rank li { margin-bottom: 1px; font-size: 10px; } .big { font-size: 18px; }
    .meta { font-size: 9.5px; }
  }
  .print-head { display: none; justify-content: space-between; align-items: flex-end; gap: 16px;
                border-bottom: 1.5px solid var(--text-primary); padding-bottom: 7px; margin-bottom: 9px; }
  .print-head h1 { font-size: 15px; margin: 0; font-weight: 600; letter-spacing: -.01em; }
  .print-head .sub { color: var(--text-secondary); margin-top: 3px; font-size: 10px; }
  .print-head .right { text-align: right; }

  /* ---------- motion ----------
     Compositor-only properties (transform, opacity), one easing curve, and every entrance is
     skipped under prefers-reduced-motion or in print so the PDF never renders a faded page. */
  :root { --ease-out: cubic-bezier(.22,.61,.36,1); }
  .btn, .fchip, .link, .tabs button, table.tbl tbody tr, .hcell, nav a {
    transition: background-color .14s ease, color .14s ease, border-color .14s ease; }
  .btn:active, .fchip:active, .link:active, .tabs button:active { transform: scale(.975); }
  .tile, .card { transition: border-color .18s ease; }

  @media (prefers-reduced-motion: no-preference) {
    .reveal { opacity: 0; transform: translateY(12px); }
    .reveal.in { opacity: 1; transform: none;
                 transition: opacity .45s var(--ease-out), transform .45s var(--ease-out);
                 transition-delay: var(--d, 0ms); }
    .fill { transform-origin: left center; transform: scaleX(0); }
    .in .fill { transform: scaleX(1); transition: transform .65s var(--ease-out);
                transition-delay: calc(var(--d, 0ms) + 80ms); }
    .seg > span { transform-origin: left center; transform: scaleX(0); }
    .in .seg > span { transform: scaleX(1); transition: transform .55s var(--ease-out);
                      transition-delay: calc(var(--d, 0ms) + 100ms); }
    .btn:active, .fchip:active, .link:active, .tabs button:active { transition: transform .09s ease-out; }
    .hcell { transition: transform .16s var(--ease-out), border-color .14s ease; }
    .heat .hcell:not(.empty):hover { transform: translateY(-1px); }
    html.theming, html.theming * { transition: background-color .32s ease, color .32s ease,
                                               border-color .32s ease !important; }
  }

  /* the sliding pill behind the active segment */
  .tabs { position: relative; }
  .tabs .ind { position: absolute; top: 3px; bottom: 3px; left: 0; border-radius: 6px;
               background: var(--surface); box-shadow: 0 1px 2px var(--ring); z-index: 0;
               transition: transform .3s var(--ease-out), width .3s var(--ease-out); }
  .tabs button { position: relative; z-index: 1; }
  .tabs button.on { background: transparent; box-shadow: none; }

  /* the toolbar earns its separation only once content is under it */
  .topbar { transition: border-color .2s ease, box-shadow .2s ease; border-bottom-color: transparent; }
  .topbar.scrolled { border-bottom-color: var(--border); }

  @media print {
    .reveal, .reveal.in { opacity: 1 !important; transform: none !important; transition: none !important; }
    .fill, .seg > span { transform: none !important; }
    .tabs .ind { display: none; }
  }
